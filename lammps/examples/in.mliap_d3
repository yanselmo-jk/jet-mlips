# JET-MLIPs example: a deployed model (python -m jet_mlip.deploy <family> <model> <file>) through ML-IAP, with the
# GPU D3 correction jet/d3, NVT at 300 K on a small LiPF6 EC/EMC electrolyte box (348 atoms, types Li C H O N F S P B).
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half -in in.mliap_d3 -var model medium_jet.pt
#   several GPUs: mpirun -np N lmp -k on g N -sf kk -pk kokkos newton on neigh half gpu/aware off -in in.mliap_d3 -var model ...
# Without D3: pair_style jet/mliap ${model} and pair_coeff * * Li C H O N F S P B.
units           metal
atom_style      atomic
atom_modify     map yes
boundary        p p p
newton          on

variable        model index medium_jet.pt
read_data       electrolyte_348.data

pair_style      hybrid/overlay jet/mliap ${model} jet/d3 9000 1600 damp_bj pbe
pair_coeff      * * jet/mliap Li C H O N F S P B
pair_coeff      * * jet/d3 Li C H O N F S P B

minimize        1.0e-4 1.0e-6 200 2000      # relax the box for this model first
reset_timestep  0
timestep        0.0005
velocity        all create 300 4928459 dist gaussian
fix             1 all nvt temp 300 300 0.1
thermo          100
thermo_style    custom step temp pe etotal press
run             1000
