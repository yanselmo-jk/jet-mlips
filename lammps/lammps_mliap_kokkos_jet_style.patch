+
+// jet-mlips: `pair_style jet/mliap <model.pt>` = `pair_style mliap unified <model.pt> 0`, KOKKOS (GPU) only: the JET
+// ML-IAP models run their CUDA graph path on Kokkos device data; without KOKKOS the style does not exist.
+template<class DeviceType>
+class PairJetMLIAPKokkos : public PairMLIAPKokkos<DeviceType> {
+public:
+  PairJetMLIAPKokkos(class LAMMPS *lmp) : PairMLIAPKokkos<DeviceType>(lmp) {}
+  void settings(int narg, char **arg) override {
+    if (narg != 1) this->error->all(FLERR, "Illegal pair_style jet/mliap command: pair_style jet/mliap <model.pt>");
+    char unified[] = "unified", ghost[] = "0";
+    char *args[3] = {unified, arg[0], ghost};
+    PairMLIAPKokkos<DeviceType>::settings(3, args);
+  }
+};
+
