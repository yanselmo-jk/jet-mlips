# JET-MLIPs example: SevenNet's own pair_style jet/e3gnn (= e3gnn; LAMMPS built with SEVENN=1) with the GPU D3 correction jet/d3,
# NVT at 300 K on an equilibrated EC/EMC box (9,520 atoms, types C H O).
#   sevenn get_model 7net-0 --enable_jet -o 7net-0_jet        # writes 7net-0_jet.pt
#   lmp -in in.sevenn_d3 -var model 7net-0_jet.pt
# Without D3: pair_style jet/e3gnn and pair_coeff * * ${model} C H O.
units           metal
atom_style      atomic
boundary        p p p
newton          on

variable        model index 7net-0_jet.pt
variable        d3 index pbe                # D3(BJ) functional of the model's training data: pbe, r2scan, ...
read_data       ecemc_9520.data

pair_style      hybrid/overlay jet/e3gnn jet/d3 9000 1600 damp_bj ${d3}
pair_coeff      * * jet/e3gnn ${model} C H O
pair_coeff      * * jet/d3 C H O

minimize        0.0 0.05 1000 10000         # relax the box for this model first (force criterion)
reset_timestep  0
timestep        0.0005
velocity        all create 300 4928459 dist gaussian
fix             1 all nvt temp 300 300 0.1
thermo          100
thermo_style    custom step temp pe etotal press
run             1000
