# JET-MLIPs example: a deployed model (python -m jet_mlip.deploy <family> <model> <file>) through ML-IAP, with the
# GPU D3 correction jet/d3, NVT at 300 K on an equilibrated EC/EMC box (9,520 atoms, types C H O).
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half -in in.mliap_d3 -var model medium_jet.pt
#   several GPUs: mpirun -np N lmp -k on g N -sf kk -pk kokkos newton on neigh half gpu/aware off -in in.mliap_d3 -var model ...
# Without D3: pair_style jet/mliap ${model} and pair_coeff * * C H O.
units           metal
atom_style      atomic
atom_modify     map yes
boundary        p p p
newton          on

variable        model index medium_jet.pt
variable        d3 index pbe                # D3(BJ) functional of the model's training data: pbe, r2scan, ...
read_data       ecemc_9520.data

pair_style      hybrid/overlay jet/mliap ${model} jet/d3 9000 1600 damp_bj ${d3}
pair_coeff      * * jet/mliap C H O
pair_coeff      * * jet/d3 C H O

minimize        0.0 0.05 1000 10000         # relax the box for this model first (force criterion)
reset_timestep  0
timestep        0.0005
velocity        all create 300 4928459 dist gaussian
fix             1 all nvt temp 300 300 0.1
thermo          100
thermo_style    custom step temp pe etotal press
run             1000
