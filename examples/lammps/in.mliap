# JET-MLIPs example: a deployed model (python -m jet_mlip.deploy <family> <model> <file>) through ML-IAP, NVT at 300 K
# on an equilibrated EC/EMC box (9,520 atoms, types C H O).
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half -in in.mliap -var model medium_jet.pt
#   several GPUs: mpirun -np N lmp -k on g N -sf kk -pk kokkos newton on neigh half gpu/aware off -in in.mliap -var model ...
# With the GPU D3 correction: in.mliap_d3.
units           metal
atom_style      atomic
atom_modify     map yes
boundary        p p p
newton          on

variable        model index medium_jet.pt
read_data       ecemc_9520.data

pair_style      jet/mliap ${model}
pair_coeff      * * C H O

minimize        0.0 0.05 1000 10000         # relax the box for this model first (force criterion)
reset_timestep  0
timestep        0.0005
velocity        all create 300 4928459 dist gaussian
fix             1 all nvt temp 300 300 0.1
thermo          100
thermo_style    custom step temp pe etotal press
run             1000
