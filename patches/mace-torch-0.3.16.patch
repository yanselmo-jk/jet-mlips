diff --git a/mace/modules/macetp_hook.py b/mace/modules/macetp_hook.py
new file mode 100644
index 0000000..a0cdf09
--- /dev/null
+++ b/mace/modules/macetp_hook.py
@@ -0,0 +1,34 @@
+"""mlip-accel hook: jet_mlip fused convolution (macetp) for InteractionBlocks.
+`macetp.convert.patch_model` attaches a `macetp` module to each block. Eval: the whole radial MLP + tensor
+product + scatter is one fused kernel (radial table). Train: the radial MLP stays in torch, the tensor product +
+scatter run in jet_mlip's tp3 (any-order autograd). Eager only (TorchScript keeps the upstream path)."""
+from typing import Optional
+
+import torch
+
+
+def macetp_fused(block, node_feats: torch.Tensor, edge_vectors: Optional[torch.Tensor],
+                 edge_index: torch.Tensor, node_attrs: torch.Tensor) -> Optional[torch.Tensor]:
+    conv = getattr(block, "macetp", None)
+    if conv is None or block.training or edge_vectors is None:
+        return None
+    return conv(node_feats, edge_vectors, edge_index, node_attrs)
+
+
+def macetp_tp3(block, node_feats: torch.Tensor, edge_attrs: torch.Tensor, tp_weights: torch.Tensor,
+               edge_index: torch.Tensor) -> Optional[torch.Tensor]:
+    conv = getattr(block, "macetp", None)
+    if conv is None or not block.training:
+        return None
+    return conv.tp3(node_feats, edge_attrs, tp_weights, edge_index)
+
+
+def macetp_lin_done(block, message: Optional[torch.Tensor]) -> bool:
+    """True if `message` is the fused convolution's and has the block's `linear` applied already (MaceTPConv.lin)."""
+    return message is not None and getattr(block.macetp, "lin", None) is not None
+
+
+def macetp_all_fused(model) -> bool:
+    """Eval with every interaction on the fused table convolution (flag set by `jet_mace.convert.patch_model`): the
+    model skips the spherical harmonics and the radial embedding, which only the upstream convolution reads."""
+    return getattr(model, "macetp_all_fused", False) and not model.training
