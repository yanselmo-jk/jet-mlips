+  static int CommBrick::*bufextra_() { return &CommBrickAccess::bufextra; }
+  static double *CommBrick::*buf_send_() { return &CommBrickAccess::buf_send; }
+  static double *CommBrick::*buf_recv_() { return &CommBrickAccess::buf_recv; }
