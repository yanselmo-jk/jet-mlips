+++ b/sevenn/nn/jet_helper.py
@@ -0,0 +1,411 @@
+"""jet backend: one fused CUDA kernel per convolution layer (Bessel * cutoff
++ radial MLP + spherical harmonics + uvu tensor product + scatter).
+
+Inference (module in eval mode): `JetEdgeEmbedding` only hands the Bessel
+coefficients over via `data[KEY.BESSEL_COEFFS]`; `JetConvolution` calls
+`jet_mlip::conv_fused` on `edge_vec` directly (no edge_attr / edge_embedding).
+Training (train mode): the original EdgeEmbedding math runs and the conv uses
+`jet_mlip::tp3`, differentiable to any order wrt x, sh and the radial weights.
+State dict keys are identical to the e3nn model (no checkpoint conversion).
+"""
+import operator
+import warnings
+from copy import deepcopy
+from typing import List, Optional, Tuple
+
+import e3nn.util.jit
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from e3nn.math import normalize2mom
+from e3nn.nn import Gate
+from e3nn.o3 import Irreps, Linear
+from e3nn.util.jit import compile_mode
+
+import sevenn._keys as KEY
+from sevenn._const import AtomGraphDataType
+
+from .convolution import IrrepsConvolution
+from .edge_embedding import BesselBasis, EdgeEmbedding, XPLORCutoff
+
+try:
+    import jet_mlip
+    import jet_mlip.ops as jet_ops
+
+    _JET_AVAILABLE = True
+except ImportError:
+    _JET_AVAILABLE = False
+
+
+def table_size(radial_table) -> int:
+    """radial_table option -> grid points: True = jet_mlip's default size, False = 0 (exact radial MLP).
+    An int > 1 is taken as the size (benchmarks)."""
+    if radial_table is True:
+        return int(jet_ops.DEFAULT_RADIAL_TABLE)
+    return int(radial_table) if radial_table else 0
+
+
+def is_jet_available() -> bool:
+    # CUDA is not required: the ops fall back to an exact (slow) torch reference
+    return _JET_AVAILABLE
+
+
+def jet_needed(func):
+    def wrapper(*args, **kwargs):
+        if is_jet_available():
+            return func(*args, **kwargs)
+        raise ImportError('jet is not available')
+
+    return wrapper
+
+
+@compile_mode('script')
+class JetEdgeEmbedding(EdgeEmbedding):
+    """EdgeEmbedding that skips Bessel / spherical harmonics in eval mode
+    (the fused op computes them) and only exposes the Bessel coefficients."""
+
+    @torch.jit.unused
+    def _forward_train(self, data: AtomGraphDataType) -> AtomGraphDataType:
+        # one kernel for Bessel * cutoff + spherical harmonics (any-order autograd)
+        rvec = data[KEY.EDGE_VEC]
+        data[KEY.EDGE_LENGTH] = torch.linalg.norm(rvec, dim=-1)
+        cut = self.cutoff_function
+        data[KEY.EDGE_EMBEDDING], data[KEY.EDGE_ATTR] = jet_ops.edge_embed(
+            rvec, self.basis_function.coeffs, cut.r_on, cut.r_cut,
+            self.spherical.lmax,
+        )
+        return data
+
+    def forward(self, data: AtomGraphDataType) -> AtomGraphDataType:
+        if self.training:
+            data = self._forward_train(data)
+        else:
+            data[KEY.BESSEL_COEFFS] = self.basis_function.coeffs
+        return data
+
+
+@compile_mode('script')
+class JetConvolution(nn.Module):
+    """Replaces IrrepsConvolution. Keeps `weight_nn` and `denominator`."""
+
+    def __init__(
+        self,
+        conv: IrrepsConvolution,
+        live_irreps: Irreps,
+        r_on: float,
+        r_cut: float,
+        radial_table: int = 0,
+        exact_backward: str = 'split',
+        layer_idx: int = -1,
+    ) -> None:
+        super().__init__()
+        assert not conv.layer_instantiated, 'already instantiated; cannot patch'
+        self.__dict__.update(deepcopy(conv.__dict__))
+        self._modules.pop('convolution', None)  # never built
+        # interaction block index t of '{t}_convolution', for jet_layer_nout (-1: never pruned)
+        self.layer_idx: int = int(layer_idx)
+        hs = self.weight_nn_kwargs['hs']
+        if self.weight_nn_kwargs['act'] is not F.silu or hs[:3] != [8, 64, 64]:
+            raise ValueError(
+                'jet needs act_radial=silu and weight_nn [8, 64, 64, *], '
+                f'got act={self.weight_nn_kwargs["act"]}, hs={hs}'
+            )
+        self.cfg = jet_mlip.config_from_sevenn_conv(conv, live_irreps)
+        if jet_ops.has_op('conv_fused'):
+            jet_ops.config_id(self.cfg)  # fail early if this config is not compiled
+        # Compiled config ids differ between jet builds, so a deployed model
+        # carries the key and resolves the id once, in the first scripted forward.
+        self.cfg_key: str = self.cfg.key
+        self.cfg_id: int = -1
+        self.r_on = float(r_on)
+        self.r_cut = float(r_cut)
+        self.act_cst = float(normalize2mom(F.silu).cst)
+        self._out_dim: int = self.cfg.out_dim
+        self.register_buffer(
+            'live_cols', self.cfg.live_weight_cols(), persistent=False
+        )
+        # Radial table (inference only): W(r) and dW/dr on a uniform grid, built from the
+        # trained weights by build_radial_table() -- lazily in eager mode, explicitly before
+        # deployment. Buffers are non-persistent: derived, and absent from any checkpoint.
+        self.radial_table: int = int(radial_table)
+        self.register_buffer('radial_tab', torch.zeros(0), persistent=False)
+        # exact-MLP backward (radial_table = 0 only), fixed at deploy time: 'split' = two kernels (grad of
+        # the hidden layer accumulated per edge in a transient E x 64 fp32 buffer), 'recompute' = one
+        # kernel that redoes the MLP backward per path group, no buffer
+        if exact_backward not in ('split', 'recompute'):
+            raise ValueError(f"exact_backward must be 'split' or 'recompute', got {exact_backward!r}")
+        if exact_backward != 'split' and self.radial_table > 0:
+            raise ValueError("exact_backward='recompute' needs the exact radial MLP (radial_table=0)")
+        self.split_bwd: bool = exact_backward == 'split'
+        # eval: the (frozen) denominator folded into the op as a float, set by train(False);
+        # train: 1.0 here and out.div(self.denominator) keeps a trainable denominator in the graph
+        self.denom: float = 1.0
+
+    @torch.jit.unused
+    def build_radial_table(self, coeffs: torch.Tensor) -> None:
+        """Fill the radial table from the current weights and the (trained) Bessel coeffs
+        (no-op if disabled or already built). fp32 only; re-run if the weights change."""
+        if self.radial_table <= 0 or self.radial_tab.numel() > 0:
+            return
+        w = self.weight_nn
+        if w is None or w.layer0.weight.dtype != torch.float32:
+            return
+        self.radial_tab = jet_ops.make_radial_table(
+            self.cfg, w.layer0.weight, w.layer1.weight,
+            w.layer2.weight[:, self.live_cols], coeffs,
+            self.r_on, self.r_cut, self.act_cst, self.radial_table,
+        )
+
+    def train(self, mode: bool = True):
+        # the table is derived from the weights: drop it whenever they may change,
+        # it is rebuilt on the next eval-mode forward
+        if mode:
+            self.radial_tab = self.radial_tab[:0]
+        self.denom = 1.0 if mode else float(self.denominator.item())
+        return super().train(mode)
+
+    def _load_from_state_dict(self, *args, **kwargs):
+        super()._load_from_state_dict(*args, **kwargs)
+        if not self.training:   # weights loaded after eval(): refresh the folded denominator
+            self.denom = float(self.denominator.item())
+
+    def instantiate(self) -> None:
+        if self.weight_nn is not None:
+            raise ValueError('Weight_nn layer already exists')
+        self.weight_nn = self.weight_nn_cls(**self.weight_nn_kwargs)
+        self.layer_instantiated = True
+
+    def _csr(
+        self, data: AtomGraphDataType, edge_src: torch.Tensor,
+        edge_dst: torch.Tensor, n_out: int, n_rows: int,
+    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """(rowptr, perm, src) int32 of the dst-grouped edge order: built by the first conv
+        layer of a step (or given by the caller) and shared through `data`; rebuilt only
+        where n_rows differs. n_rows is the number of destination rows the built CSR covers:
+        n_out normally, n_1 = nout[0] with jet_layer_nout, so that every later layer reuses
+        the prefix rowptr[:n_out+1] (edges are dst-grouped, all of them < n_1)."""
+        # shape checks guard against a data dict reused with other edges or another n_out
+        if KEY.JET_ROWPTR in data and data[KEY.JET_ROWPTR].numel() == n_rows + 1 \
+                and data[KEY.JET_PERM].numel() == edge_dst.numel():
+            return data[KEY.JET_ROWPTR][: n_out + 1], data[KEY.JET_PERM], data[KEY.JET_SRC]
+        rowptr, perm = torch.ops.jet_mlip.build_csr(edge_dst, n_rows)
+        src = edge_src.to(torch.int32)
+        data[KEY.JET_ROWPTR] = rowptr
+        data[KEY.JET_PERM] = perm
+        data[KEY.JET_SRC] = src
+        return rowptr[: n_out + 1], perm, src
+
+    @torch.jit.unused
+    def _conv_fused_eager(
+        self, data, x, edge_vec, src, dst, w1, w2, w3, coeffs, n_out: int,
+        n_rows: int,
+    ) -> torch.Tensor:
+        self.build_radial_table(coeffs)
+        csr = None
+        if x.is_cuda and jet_ops.has_op('conv_fused'):   # else: torch reference, no CSR
+            rowptr, perm, src = self._csr(data, src, dst, n_out, n_rows)
+            csr = (rowptr, perm)
+        return jet_ops.conv_fused(
+            self.cfg, x, edge_vec, src, dst, w1, w2, w3, coeffs, self.denom,
+            self.r_on, self.r_cut, self.act_cst, n_out, csr=csr,
+            table=self.radial_tab if self.radial_tab.numel() > 0 else None,
+            split_bwd=self.split_bwd,
+        )
+
+    @torch.jit.unused
+    def _forward_train(
+        self, data: AtomGraphDataType, x: torch.Tensor,
+        src: torch.Tensor, dst: torch.Tensor, n_out: int,
+    ) -> torch.Tensor:
+        sh = data[self.key_filter]
+        # prune the (64, NW_full) last-layer weight, not the (E, NW_full) output:
+        # advanced-indexing backward on the per-edge tensor was 40 % of a train step.
+        nn = self.weight_nn
+        h = data[self.key_weight_input]
+        for l in (nn.layer0, nn.layer1):
+            # e3nn _Layer with act: normalize2mom(silu)(x @ (w / sqrt(h_in*var_in))) * sqrt(var_out),
+            # the silu chain fused (fwd / bwd / bwd-bwd kernels)
+            h = jet_ops.silu_norm(
+                h @ (l.weight / (l.h_in * l.var_in) ** 0.5),
+                self.act_cst * l.var_out**0.5,
+            )
+        l2 = nn.layer2  # e3nn _Layer without act: x @ (w / sqrt(h_in*var_in/var_out))
+        w3 = l2.weight[:, self.live_cols] / (l2.h_in * l2.var_in / l2.var_out) ** 0.5
+        weight = h @ w3
+        if src.numel() == 0:
+            return x.new_zeros(n_out, self._out_dim) + (sh.sum() + weight.sum()) * 0
+        return jet_ops.tp3(self.cfg, x, sh, weight, src, dst, n_out)
+
+    def forward(self, data: AtomGraphDataType) -> AtomGraphDataType:
+        assert self.weight_nn is not None, 'Weight_nn is not instantiated'
+        x = data[self.key_x]
+        n_out = x.shape[0]  # local atoms; ghosts (if any) are appended below
+        n_rows = n_out  # rows the shared CSR covers: n_1 with jet_layer_nout, else n_out
+        if self.layer_idx >= 0 and KEY.JET_LAYER_NOUT in data:
+            # halo pruning (shared interface): block t fills nodes [0, n_{t+1}) only, the rest of
+            # the block input is a ghost that later blocks never look at
+            assert not self.training, 'jet_layer_nout (halo pruning) is inference only'
+            nout = data[KEY.JET_LAYER_NOUT]
+            assert nout.numel() > self.layer_idx, (
+                'jet_layer_nout is shorter than the model: no n_{t+1} for this block'
+            )
+            n_out = int(nout[self.layer_idx].item())
+            n_rows = int(nout[0].item())
+        if self.is_parallel:
+            x = torch.cat([x, data[KEY.NODE_FEATURE_GHOST]])
+        edge_src = data[self.key_edge_idx][1]
+        edge_dst = data[self.key_edge_idx][0]
+
+        if self.training:
+            out = self._forward_train(data, x, edge_src, edge_dst, n_out)
+            out = out.div(self.denominator)
+        else:
+            edge_vec = data[KEY.EDGE_VEC]
+            coeffs = data[KEY.BESSEL_COEFFS]
+            # conv_fused differentiates x and edge_vec only (forces); a backward
+            # that needs the weight / coefficient grads raises (use train mode)
+            w1 = self.weight_nn.layer0.weight
+            w2 = self.weight_nn.layer1.weight
+            w3 = self.weight_nn.layer2.weight[:, self.live_cols]
+            if edge_src.numel() == 0:
+                out = x.new_zeros(n_out, self._out_dim)
+                out = out + (edge_vec.sum() + x.sum()) * 0  # keep in graph
+            elif torch.jit.is_scripting():
+                if self.cfg_id < 0:  # once per process; raises if this build lacks the config
+                    self.cfg_id = torch.ops.jet_mlip.config_index(self.cfg_key)
+                rowptr, perm, src = self._csr(data, edge_src, edge_dst, n_out, n_rows)
+                tab: Optional[torch.Tensor] = None
+                if self.radial_tab.numel() > 0:
+                    tab = self.radial_tab
+                out = torch.ops.jet_mlip.conv_fused(
+                    x, edge_vec, src, rowptr, perm, w1, w2, w3, coeffs, self.denom,
+                    self.r_on, self.r_cut, self.act_cst, self.cfg_id, tab, self.split_bwd,
+                )
+            else:
+                out = self._conv_fused_eager(
+                    data, x, edge_vec, edge_src, edge_dst, w1, w2, w3, coeffs, n_out,
+                    n_rows,
+                )
+
+        data[self.key_x] = out
+        return data
+
+
+# ---- inference-time rewrites of the e3nn glue (forward bitwise identical) ----------------
+@compile_mode('script')
+class _Split(nn.Module):
+    """Gate's _Sortcut (e3nn Extract: zero-fill + copy per output) when the three outputs are
+    consecutive input ranges: views instead, so the backward is one cat."""
+
+    def __init__(self, sizes: List[int]) -> None:
+        super().__init__()
+        self.sizes = sizes
+
+    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        a, b, c = torch.split(x, self.sizes, -1)
+        return a, b, c
+
+
+def _split_gate(gate: Gate) -> None:
+    cut = gate.sc.cut
+    want, i = [], 0
+    for ins in cut.instructions:
+        want.append(tuple(range(i, i + len(ins))))
+        i += len(ins)
+    if list(cut.instructions) != want or i != len(cut.irreps_in) or len(want) != 3:
+        return   # outputs are not consecutive input ranges: keep e3nn's Extract
+    gate.sc = _Split([sum(cut.irreps_in[k].dim for k in ins) for ins in want])
+
+
+def _split_linear(lin: Linear) -> None:
+    """Rebuild e3nn's fx graph with the per-irrep `x.narrow`s replaced by one `split` + getitems.
+    Same views in the forward; the backward becomes one cat instead of a zero-filled full-size
+    copy per irrep summed with adds."""
+    from e3nn.o3._linear import _codegen_linear
+
+    if lin.weight.dim() != 1 or len(lin.irreps_in) < 2:
+        return   # f_in/f_out layouts never built by sevenn; single irrep has no narrow
+    gm, _, _ = _codegen_linear(
+        lin.irreps_in, lin.irreps_out, lin.instructions, None, None,
+        shared_weights=lin.shared_weights, optimize_einsums=lin._optimize_einsums,
+    )
+    g = gm.graph
+
+    def root(n):
+        while n.op != 'placeholder':
+            n = n.args[0]
+        return n.target
+
+    narrows = [n for n in g.nodes if n.op == 'call_method' and n.target == 'narrow'
+               and n.args[1] == -1 and root(n) == 'x']
+    if not narrows:
+        return
+    base = narrows[0].args[0]
+    narrows.sort(key=lambda n: n.args[2])
+    if any(n.args[0] is not base for n in narrows) or narrows[0].args[2] != 0 \
+            or any(a.args[2] + a.args[3] != b.args[2] for a, b in zip(narrows, narrows[1:])) \
+            or narrows[-1].args[2] + narrows[-1].args[3] != lin.irreps_in.dim:
+        return   # not a tiling of the input: keep e3nn's graph
+    with g.inserting_before(narrows[0]):
+        parts = g.call_method('split', (base, [n.args[3] for n in narrows], -1))
+    for k, n in enumerate(narrows):
+        with g.inserting_before(n):
+            item = g.call_function(operator.getitem, (parts, k))
+        n.replace_all_uses_with(item)
+        g.erase_node(n)
+    g.lint()
+    gm.recompile()
+    if e3nn.get_optimization_defaults()['jit_mode'] == 'script':   # as CodeGenMixin._codegen_register
+        gm = e3nn.util.jit.compile(gm, recurse=False)
+    lin._compiled_main = gm   # swaps the submodule; it stays listed in lin.__codegen__
+
+
+def optimize_for_inference(model: nn.Module) -> nn.Module:
+    """In-place, for jet inference models (deploy / ASE calculator / ML-IAP): e3nn Linear
+    input narrows -> split, Gate Extract -> split views. Forward bitwise identical, state_dict
+    keys unchanged; a module that cannot be rewritten is left as it is."""
+    for mod in model.modules():
+        try:
+            if isinstance(mod, Linear):
+                _split_linear(mod)
+            elif isinstance(mod, Gate):
+                _split_gate(mod)
+        except Exception as e:   # pragma: no cover - defensive, the model still works unrewritten
+            import warnings
+            warnings.warn(f'jet optimize_for_inference: {type(mod).__name__} left as is ({e})')
+    return model
+
+
+@jet_needed
+def patch_edge_embedding(edge_embedding: EdgeEmbedding) -> JetEdgeEmbedding:
+    if not isinstance(edge_embedding.basis_function, BesselBasis):
+        raise ValueError('jet supports only the bessel radial basis')
+    if not isinstance(edge_embedding.cutoff_function, XPLORCutoff):
+        raise ValueError('jet supports only the XPLOR cutoff function')
+    sph = edge_embedding.spherical
+    if not (sph.sph.normalize and sph.normalization == 'component'):
+        raise ValueError(
+            'jet supports only normalize=True, component-normalized spherical harmonics'
+        )
+    return JetEdgeEmbedding(
+        edge_embedding.basis_function,
+        edge_embedding.cutoff_function,
+        edge_embedding.spherical,
+    )
+
+
+@jet_needed
+def patch_convolution(
+    irreps_convolution: IrrepsConvolution,
+    live_irreps: Optional[Irreps],
+    edge_embedding: EdgeEmbedding,
+    radial_table: int = 0,
+    exact_backward: str = 'split',
+    layer_idx: int = -1,
+) -> JetConvolution:
+    cut = edge_embedding.cutoff_function
+    assert isinstance(cut, XPLORCutoff), 'patch_edge_embedding validates this'
+    return JetConvolution(
+        irreps_convolution, live_irreps, cut.r_on, cut.r_cut, radial_table, exact_backward,
+        layer_idx,
+    )
