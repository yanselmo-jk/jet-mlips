+// The plain brick comm keeps its swap tables on the host. CommKokkos (used
+// with -k on) derives from CommBrick but may leave the host sendlist stale,
+// so only the exact CommBrick class is accepted.
+CommBrick *PairE3GNNParallel::get_comm_brick() {
+  if (typeid(*comm) != typeid(CommBrick)) {
+    error->all(FLERR, "e3gnn/parallel requires comm_style brick without the "
+                      "KOKKOS package enabled (-k on)");
