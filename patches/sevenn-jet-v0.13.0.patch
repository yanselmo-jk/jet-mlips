+struct CommBrickAccess : CommBrick {
+  static int CommBrick::*nswap_() { return &CommBrickAccess::nswap; }
+  static int *CommBrick::*sendnum_() { return &CommBrickAccess::sendnum; }
+  static int *CommBrick::*recvnum_() { return &CommBrickAccess::recvnum; }
+  static int *CommBrick::*sendproc_() { return &CommBrickAccess::sendproc; }
+  static int *CommBrick::*recvproc_() { return &CommBrickAccess::recvproc; }
