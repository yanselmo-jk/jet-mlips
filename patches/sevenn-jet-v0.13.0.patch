+void PairE3GNNParallel::forward_comm_gnn() {
+  CommBrick *cb = get_comm_brick();
+  const int nswap = cb->*CommBrickAccess::nswap_();
+  const int *sendnum = cb->*CommBrickAccess::sendnum_();
+  const int *recvnum = cb->*CommBrickAccess::recvnum_();
+  const int *sendproc = cb->*CommBrickAccess::sendproc_();
+  const int *recvproc = cb->*CommBrickAccess::recvproc_();
+  const int *firstrecv = cb->*CommBrickAccess::firstrecv_();
+  int **sendlist = cb->*CommBrickAccess::sendlist_();
+  int iswap, n;
+  MPI_Request request;
+
+  const int nsize = x_dim;
+  float *buf_send_, *buf_recv_;
+  if (use_cuda_mpi) {
+    DeviceBuffManager::getInstance().get_buffer(
+        cb->*CommBrickAccess::maxsend_() + cb->*CommBrickAccess::bufextra_(),
+        cb->*CommBrickAccess::maxrecv_(), buf_send_, buf_recv_);
+  } else {
+    buf_send_ = reinterpret_cast<float *>(cb->*CommBrickAccess::buf_send_());
+    buf_recv_ = reinterpret_cast<float *>(cb->*CommBrickAccess::buf_recv_());
+  }
+  if (!comm_preprocess_done) {
+    notify_proc_ids(sendproc, recvproc);
+  }
+  if (nswap > 6)
+    error->all(FLERR, "PairE3GNNParallel: Cell size is too small. Please use a "
+                      "single GPU or make a supercell");
+
+  for (iswap = 0; iswap < nswap; iswap++) {
+    if (sendproc[iswap] == comm->me) continue;
+
+    if (!comm_preprocess_done) {
+      pack_forward_init(sendnum[iswap], sendlist[iswap], iswap);
+      unpack_forward_init(recvnum[iswap], firstrecv[iswap], iswap);
+    } else {
+      n = pack_forward_comm_gnn(buf_send_, iswap);
+
+      if (recvnum[iswap])
+        MPI_Irecv(buf_recv_, nsize * recvnum[iswap], MPI_FLOAT, recvproc[iswap],
+                  0, world, &request);
+      if (sendnum[iswap])
+        MPI_Send(buf_send_, n, MPI_FLOAT, sendproc[iswap], 0, world);
+      if (recvnum[iswap]) MPI_Wait(&request, MPI_STATUS_IGNORE);
+
+      unpack_forward_comm_gnn(buf_recv_, iswap);
+    }
+  }
+}
